se_mode=cosmic

BSE_LIB=libbse.a
BSE_TEST=petar.cosmic
BSE_PATH=cosmic
# METISSE is vendored in cosmic/METISSE/ and always compiled with COSMIC
CXXFLAGS = -D COSMIC -D BSE_BASE -D USE_METISSE

TARGET: $(BSE_LIB) $(BSE_TEST) petar.get.init.binary

FC=gfortran
CXX=g++

CXXFLAGS += -O2 -std=c++11
FFLAGS += -O2 -fPIC -fallow-argument-mismatch
FCLIBS = -lgfortran -lm

VPATH=$(BSE_PATH)

# ── Fixed-form COSMIC sources (.f) ────────────────────────────────────────────
SRC:= $(shell find $(BSE_PATH) -maxdepth 1 -type f \
          \( -iname '*.f' ! -iname '.*' ! -iname '[sb]se.f' \
             ! -iname 'mo[sb]se.f' ! -iname 'popbin.f' \
             ! -iname 'metisse_stubs.f' \) )
SRC += $(shell find $(BSE_PATH)/SSE -type f -iname '*.f' ! -iname '.*')
OBJ:= $(SRC:.f=.o)

# ── METISSE free-form sources (.f90) — vendored in cosmic/METISSE/ ───────────
METISSE_DIR = $(BSE_PATH)/METISSE
# Ordered to satisfy module dependencies
METISSE_SRC = \
	$(METISSE_DIR)/track_support.f90 \
	$(METISSE_DIR)/c_m_interface.f90 \
	$(METISSE_DIR)/interp_support.f90 \
	$(METISSE_DIR)/sse_support.f90 \
	$(METISSE_DIR)/remnant_support.f90 \
	$(METISSE_DIR)/z_support.f90 \
	$(METISSE_DIR)/METISSE_miscellaneous.f90 \
	$(METISSE_DIR)/comenv_lambda.f90 \
	$(METISSE_DIR)/METISSE_zcnsts.f90 \
	$(METISSE_DIR)/METISSE_star.f90 \
	$(METISSE_DIR)/METISSE_hrdiag.f90 \
	$(METISSE_DIR)/METISSE_deltat.f90 \
	$(METISSE_DIR)/METISSE_mlwind.f90 \
	$(METISSE_DIR)/METISSE_gntage.f90 \
	$(METISSE_DIR)/METISSE_utils.f90
METISSE_OBJ = $(METISSE_SRC:.f90=.o)

# Free-form Fortran: write/search .mod files in the METISSE source directory
METISSE_FFLAGS = -ffree-form -J$(METISSE_DIR) -I$(METISSE_DIR)

$(METISSE_DIR)/%.o: $(METISSE_DIR)/%.f90
	$(FC) $(FFLAGS) $(METISSE_FFLAGS) -c -o $@ $<

# ─────────────────────────────────────────────────────────────────────────────

$(BSE_LIB): $(OBJ) $(METISSE_OBJ)
	ar rcs $@ $^

$(BSE_TEST): bse_test.cxx $(BSE_LIB) bse_interface.h
	$(CXX) $(CXXFLAGS) $< -o $@ -L./ -lbse $(FCLIBS)

petar.get.init.binary: get_init_binary_bse.sh
	ln -sf $< $@

clean:
	rm -f $(BSE_PATH)/*.o $(BSE_PATH)/SSE/*.o $(METISSE_DIR)/*.o \
	      $(METISSE_DIR)/*.mod *.o $(BSE_TEST) $(BSE_LIB)
